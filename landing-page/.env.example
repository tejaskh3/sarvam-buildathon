# URL of the Yaadein agent server (app/server.js).
# Local dev: leave unset → defaults to http://localhost:3000
# Deployment: set to your hosted agent server URL, e.g.
# VITE_API_BASE=https://yaadein-agent.up.railway.app
VITE_API_BASE=

# Enables the lazy-loaded TypeScript Pipecat voice client on #/try.
# Local development:
# VITE_REALTIME_URL=http://localhost:7860
#
# Production must be a public HTTPS endpoint that can establish WebRTC media.
# Do not point this at a Railway private domain: browsers cannot resolve
# *.railway.internal, and Railway public networking does not expose UDP.
VITE_REALTIME_URL=
