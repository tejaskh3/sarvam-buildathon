node_modules/
.env
app/.env
# Vite's local overrides. VITE_* values are compiled into the browser bundle, so
# only publishable keys belong here — but they stay untracked either way, since
# each of us points at a different local server.
.env.local
.env.*.local
*.log
.DS_Store

# Runtime state, not source. The database holds real conversations and the audio
# folders hold recorded voices — neither belongs in a repo we share or make
# public. The ack clips are re-rendered by ensureAcks() on boot, so nothing here
# is lost by not tracking it. Railway keeps this on a persistent volume and
# .railwayignore already excludes it from deploys.
app/data/
