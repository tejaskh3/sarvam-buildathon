# Copy to app/.env for local dev. Railway holds the real values as env vars.
# Full setup instructions: docs/07-keys-and-accounts.md

# ── required ──
# Every model in the product is Sarvam: saaras:v3 (STT), sarvam-30b and
# sarvam-105b (chat), bulbul:v3 (TTS), plus /translate. One key covers all.
SARVAM_API_KEY=your_key_from_dashboard.sarvam.ai

# ── Dodo Payments ──
DODO_MODE=test
# Developer → Webhooks → signing secret. Without it /api/dodo/webhook is 503.
DODO_WEBHOOK_SECRET=
# Developer → API Keys. The server never calls Dodo's API — checkout is a
# hosted link and we only listen for the webhook — so this is here for the
# scripts that create products, not for the running app.
DODO_API_KEY=
# Product → payment link. Without it the Family card shows no "pay early" link.
DODO_FAMILY_LINK=
# Without it the Care Centre card falls back to the families waitlist, which is
# the wrong offer for a care home — set it if you want that card to work.
DODO_CENTRE_LINK=

# ── the first-fifty waitlist ──
# All three are defaulted in code, so #/waitlist works with none of them set.
# Only change them if the cohort itself changes.
WAITLIST_SEATS=50
WAITLIST_FOUNDING=10
WAITLIST_FREE_MONTHS=3

# ── email (Resend) ──
# Only the receipts: a seat confirmation, and "we'll tell you when the app is
# out". Nothing here is load-bearing — with no key set, sign-ups still succeed
# and the page stops promising an inbox it can't deliver to (`emailed: false`).
RESEND_API_KEY=
# Resend's sandbox sender needs no verified domain but will ONLY deliver to the
# address that owns the Resend account. Point this at a verified domain before
# real families sign up, or their confirmations silently go nowhere.
EMAIL_FROM=Yaadein <onboarding@resend.dev>
# Where a reply lands. Worth setting: the footer promises a person reads it.
EMAIL_REPLY_TO=
# Absolute base for links inside emails — a relative href is meaningless in an
# inbox. Defaults to the Railway URL.
PUBLIC_URL=https://sarvam-buildathon-production.up.railway.app

# ── access ──
# Legacy admin allowlist; registered numbers get in without being listed here.
ALLOWED_PHONES=1234567890,1231231239,1231231238

# ── realtime voice (optional, local only) ──
# The Pipecat sidecar in realtime/ is a SECOND process: `npm run realtime`.
# It is a local-only feature — production is a single Node service on one port,
# and Railway does not accept inbound UDP, so WebRTC cannot reach a container
# there without a relay. See docs/03-tech-plan.md.
#
# Read by realtime/bot.py — where the Node server is, from the sidecar's side:
YAADEIN_API_BASE=http://127.0.0.1:3000
#
# Read by the FRONTEND, so it belongs in landing-page/.env.local, not here.
# Setting it is what switches #/try from the record-then-upload loop to the
# continuous WebRTC session. Leave it UNSET in any build you deploy:
#   VITE_REALTIME_URL=http://localhost:7860
