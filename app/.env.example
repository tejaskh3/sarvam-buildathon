# Copy to app/.env for local dev. Railway holds the real values as env vars.
# Full setup instructions: docs/07-keys-and-accounts.md

# ── required ──
SARVAM_API_KEY=your_key_from_dashboard.sarvam.ai

# carrier. NEVER set this on Railway.

# ── Dodo Payments (Tejas) ──
DODO_MODE=test
# Developer → Webhooks → signing secret. Without it /api/dodo/webhook is 503.
DODO_WEBHOOK_SECRET=
# Developer → API Keys. Not used yet — kept so Phase C isn't blocked.
DODO_API_KEY=
# Product → payment link. Without it the Family pricing card is disabled.
DODO_FAMILY_LINK=
# Leave empty and the Care Centre card falls back to a WhatsApp "Talk to us".
DODO_CENTRE_LINK=
DODO_CONTACT_WHATSAPP=

# ── the first-fifty waitlist ──
# All three are defaulted in code, so #/waitlist works with none of them set.
# Only change them if the cohort itself changes.
WAITLIST_SEATS=50
WAITLIST_FOUNDING=10
WAITLIST_FREE_MONTHS=3

# ── access ──
# Legacy admin allowlist; registered numbers get in without being listed here.
ALLOWED_PHONES=1234567890,1231231239,1231231238
